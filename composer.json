{
  "name": "tomise/laravel-barion",
  "description": "A simple Laravel package for Barion payment gateway",
  "version": "0.10.0",
  "type": "library",
  "license": "MIT",
  "authors": [
    {
      "name": "Vira Tamás",
      "email": "vira.tamas97@gmail.com"
    }
  ],
  "minimum-stability": "dev",
  "prefer-stable": true,
  "autoload": {
    "psr-4": {
      "Tomise\\Barion\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tomise\\Barion\\Tests\\": "tests/"
    }
  },
  "require": {
    "php": "^8.2",
    "guzzlehttp/guzzle": "^7.8",
    "illuminate/database": "^10.0|^11.0|^12.0|^13.0",
    "illuminate/support": "^10.0|^11.0|^12.0|^13.0"
  },
  "extra": {
    "laravel": {
      "providers": [
        "Tomise\\Barion\\Providers\\BarionServiceProvider"
      ]
    }
  },
  "config": {
    "sort-packages": true,
    "preferred-install": "dist",
    "optimize-autoloader": true
  },
  "require-dev": {
    "orchestra/testbench": "^8.0|^9.0|^10.0|^11.0",
    "phpunit/phpunit": "^10.5|^11.0|^12.0"
  }
}
